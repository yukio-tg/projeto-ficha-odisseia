rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin check ──────────────────────────────────────────────────────────
    // Admins são identificados pela existência do documento /admins/{uid}.
    // O primeiro admin deve ser criado manualmente via Firebase Console.
    // Admins podem adicionar outros admins gravando nesta coleção.
    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── admins collection ─────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── wiki_tags collection ──────────────────────────────────────────────
    // Tags públicas para autocomplete de tipos e regiões.
    // Qualquer autenticado pode ler. Qualquer autenticado pode criar/atualizar
    // (count increment via merge). Admin pode deletar.
    match /wiki_tags/{tagId} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                                           .affectedKeys().hasOnly(['count']);
      allow delete: if isAdmin();
    }

    // ── wiki_docs collection ──────────────────────────────────────────────
    // Leitura: qualquer pessoa (inclusive não autenticados).
    // Criação: qualquer autenticado; documentos canônicos exigem ser admin.
    // Edição: o próprio autor (sem alterar status/authorId) ou admin (sem restrição).
    // Exclusão: o próprio autor ou admin.
    match /wiki_docs/{docId} {
      allow read: if true;

      allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && (request.resource.data.status == 'community' || isAdmin());

      allow update: if request.auth != null
          && (
            isAdmin()
            || (
              resource.data.authorId == request.auth.uid
              && !request.resource.data.diff(resource.data)
                                     .affectedKeys().hasAny(['status', 'authorId'])
            )
          );

      allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ── users collection ──────────────────────────────────────────────────
    // Leitura: qualquer autenticado (lookup email→uid).
    // Escrita geral: só o próprio perfil.
    // sharedSheetIds de outro perfil: só o dono da ficha, e só aquele id
    // (convite em addToUserSharedSheets). Depois de transferir a ficha, o
    // editor que era dono pode remover esse único id da lista do novo dono.
    match /users/{uid} {
      function sharedIds(data) {
        return data.get('sharedSheetIds', []);
      }

      function onlySharedSheetIdsChanged() {
        return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['sharedSheetIds']);
      }

      function addedSharedIds() {
        return sharedIds(request.resource.data).removeAll(sharedIds(resource.data));
      }

      function removedSharedIds() {
        return sharedIds(resource.data).removeAll(sharedIds(request.resource.data));
      }

      function oneSharedIdDelta() {
        return (addedSharedIds().size() == 1 && removedSharedIds().size() == 0)
            || (addedSharedIds().size() == 0 && removedSharedIds().size() == 1);
      }

      function deltaSharedId() {
        return addedSharedIds().size() == 1 ? addedSharedIds()[0] : removedSharedIds()[0];
      }

      function sheetPath(id) {
        return /databases/$(database)/documents/sheets/$(id);
      }

      function ownsDeltaSheet() {
        return exists(sheetPath(deltaSharedId()))
            && get(sheetPath(deltaSharedId())).data.owner == request.auth.uid;
      }

      function editorRemovesSheetFromNewOwner() {
        return removedSharedIds().size() == 1
            && addedSharedIds().size() == 0
            && exists(sheetPath(deltaSharedId()))
            && get(sheetPath(deltaSharedId())).data.owner == uid
            && request.auth.uid in get(sheetPath(deltaSharedId())).data.get('sharedUidsEdit', []);
      }

      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
                    && request.auth.uid != uid
                    && onlySharedSheetIdsChanged()
                    && (
                      (oneSharedIdDelta() && ownsDeltaSheet())
                      || editorRemovesSheetFromNewOwner()
                    );
    }

    match /sheets/{sheetId} {

      function isOwner() {
        return request.auth.uid == resource.data.owner;
      }

      function hasReadAccess() {
        return request.auth.uid in resource.data.get('sharedUids', [])
            || resource.data.get('isPublic', false) == true;
      }

      function hasEditAccess() {
        return request.auth.uid in resource.data.get('sharedUidsEdit', [])
            || (resource.data.get('isPublic', false) == true
                && resource.data.get('publicPermission', 'read') == 'edit');
      }

      function onlyDataFields() {
        return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['data', 'name', 'updatedAt', 'theme']);
      }

      // "Público" ainda exige conta. O texto do compartilhamento diz isso.
      // Presença continua só para autenticados, no bloco abaixo.
      allow read:   if request.auth != null && (isOwner() || hasReadAccess());
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
                    && (isOwner() || (hasEditAccess() && onlyDataFields()));
      allow delete: if request.auth != null && isOwner();

      // Subcoleção de presença: quem está visualizando a ficha agora.
      // Leitura aberta para qualquer autenticado; escrita apenas pelo próprio uid.
      match /presence/{uid} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
