{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "actual-development",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/ficha",
        "destination": "/ficha/ficha.html"
      },
      {
        "source": "/wiki",
        "destination": "/wiki/index.html"
      },
      {
        "source": "/wiki/doc",
        "destination": "/wiki/doc.html"
      },
      {
        "source": "/wiki/criar",
        "destination": "/wiki/criar.html"
      },
      {
        "source": "/wiki/editar",
        "destination": "/wiki/editar.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
